# ── Database (required on Vercel) ───────────────────────────────────────────
# Runtime app traffic (recommended for Vercel / serverless):
# Supabase transaction pooler / Neon / CloudBase / any Postgres URL.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Schema migrations (recommended): use a direct or session-style connection.
# For Supabase, prefer the direct connection if your environment supports it,
# otherwise use the session pooler on port 5432.
# If DATABASE_MIGRATION_URL is omitted and DATABASE_URL is a Supabase 6543
# pooler URL, this repo will automatically try the matching 5432 session pooler.
# DATABASE_MIGRATION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional SSL toggles for managed Postgres:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# If your provider uses a private / self-signed CA and Vercel logs show
# SELF_SIGNED_CERT_IN_CHAIN, set DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Local only — force embedded PGlite (no Postgres needed):
# DATABASE_MODE=embedded

# ── Supabase JS client (optional; does NOT create schema) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backward-compatible alias supported by this repo:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── CloudBase Auth (optional but recommended for multi-device accounts) ─────
# Web (public):
NEXT_PUBLIC_CLOUDBASE_ENV_ID=
# Server (private — set in Vercel project settings, never commit):
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ── Optional CloudBase storage bucket for future uploads ────────────────────
# NEXT_PUBLIC_CLOUDBASE_STORAGE_BUCKET=
