# ── Database (required on Vercel) ───────────────────────────────────────────
# Postgres URL (Supabase recommended)
# Used by Prisma Client for app execution (Connection Pooler):
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used by Prisma CLI for migrations (Direct Connection):
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local only — force embedded PGlite (no Postgres needed):
# DATABASE_MODE=embedded

# ── CloudBase Auth (optional but recommended for multi-device accounts) ─────
# Web (public):
NEXT_PUBLIC_CLOUDBASE_ENV_ID=
# Server (private — set in Vercel project settings, never commit):
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ── Optional CloudBase storage bucket for future uploads ────────────────────
# NEXT_PUBLIC_CLOUDBASE_STORAGE_BUCKET=
