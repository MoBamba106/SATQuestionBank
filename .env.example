# =============================================================================
# SAT Nexus — environment variables
# Prefer names injected by the Supabase Vercel integration when available.
# Aliases in parentheses are still accepted by the app.
# =============================================================================

# ── Database (required on Vercel) ───────────────────────────────────────────
# Runtime app traffic — Supabase transaction pooler (port 6543) preferred.
# Supabase integration name first; DATABASE_URL is a manual alias.
POSTGRES_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# POSTGRES_PRISMA_URL=   # optional; also accepted as runtime URL
# DATABASE_URL=          # manual alias for POSTGRES_URL

# Schema migrations — direct / non-pooling (or session pooler on 5432).
POSTGRES_URL_NON_POOLING=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_MIGRATION_URL=  # manual alias for POSTGRES_URL_NON_POOLING

# Optional SSL toggles for managed Postgres.
# TLS is managed by the app via ssl options — any sslmode=/sslcert=… params baked
# into dashboard URLs (Supabase adds sslmode=require by default) are ignored on
# purpose, because node-postgres lets them override the ssl option and that
# silently re-breaks self-signed chain handling.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Supabase hosts (pooler + direct) default to relaxed chain verification since
# their chains use a self-signed root CA. If Vercel logs still show
# SELF_SIGNED_CERT_IN_CHAIN (e.g. self-hosted Postgres), set:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Local only — force embedded PGlite (no Postgres needed).
# Do NOT set this on Vercel if POSTGRES_URL is configured — a real Postgres
# URL always wins, but leaving DATABASE_MODE=embedded is confusing.
# DATABASE_MODE=embedded

# Parts of the Supabase connection string (optional; not used by this app if
# POSTGRES_URL is set). Safe to omit when you already have full URLs.
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# ── Supabase Auth + JS client ───────────────────────────────────────────────
# Browser-safe public values (also accept non-NEXT_PUBLIC Supabase names).
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_URL=          # alias accepted server-side / when integration sets it

NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=     # alias from Supabase integration
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # newer publishable key alias
# SUPABASE_PUBLISHABLE_KEY=

# Server-only secret (never expose to the browser). Prefer SERVICE_ROLE_KEY;
# SUPABASE_SECRET_KEY is accepted as an alias from newer Supabase dashboards.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Not used by this app (Supabase JWT signing secret). Safe to delete on Vercel.
# SUPABASE_JWT_SECRET=

# ── Admin console ────────────────────────────────────────────────────────────
# Comma-separated emails with admin access (console, feedback, impersonation).
ADMIN_EMAILS=you@example.com

# ── Site URL (password-reset redirects, share links) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Emails (Resend: password resets + duel invites) ─────────────────────────
# With RESEND_API_KEY + SUPABASE_SERVICE_ROLE_KEY, /api/auth/forgot-password
# mints a Supabase recovery link and sends a branded email via Resend.
# /api/duels also sends duel challenge invites through the same key.
# Without Resend, password resets fall back to Supabase's own mailer and duel
# invites still reach the opponent in-app (their Duels inbox).
RESEND_API_KEY=re_xxxxxxxx
# From address. IMPORTANT: Resend's default test sender (onboarding@resend.dev)
# can ONLY deliver to your own account email. To email real users you must
# verify a domain in Resend (add the SPF/DKIM records it gives you) and set
# RESEND_FROM_EMAIL to an address on that verified domain.
RESEND_FROM_EMAIL=SAT Nexus <noreply@yourdomain.com>

# ── Feedback → GitHub bot (optional) ────────────────────────────────────────
# FEEDBACK_GITHUB_TOKEN=
# FEEDBACK_GITHUB_REPO=MoBamba106/SATQuestionBank

# ── Desmos (optional) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_DESMOS_API_KEY=
