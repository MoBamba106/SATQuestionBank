# Embedded PGlite is the default. Leave DATABASE_URL unset (or commented)
# unless you intentionally point at a real Postgres instance.
# DATABASE_URL=******localhost:5432/sat_nexus
DATABASE_MODE=embedded
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
