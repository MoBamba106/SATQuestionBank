{
  "name": "sat-nexus",
  "private": true,
  "version": "1.9.0",
  "description": "SAT Nexus – College Board question bank and practice tests",
  "author": "SAT Nexus",
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop": "node desktop-launcher.js",
    "desktop:install": "npm install --save-dev electron@31 electron-builder@24 --no-audit --no-fund",
    "desktop:build": "node scripts/build-desktop.js",
    "app:build": "node scripts/build-desktop.js",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node scripts/with-env.js TAURI=1 -- next dev -p 1420",
    "tauri:build": "node scripts/build-tauri.js",
    "tauri:build:frontend": "node scripts/tauri-prebuild.js && node scripts/with-env.js TAURI=1 -- next build && node scripts/tauri-postbuild.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "ai.arena.satnexus",
    "productName": "SAT Nexus",
    "copyright": "Copyright © SAT Nexus",
    "directories": {
      "output": "dist-electron",
      "buildResources": "src-tauri/icons"
    },
    "files": [
      "electron-main.js",
      "package.json",
      "public/**/*",
      "src/data/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!.next/cache/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": ["**/*"]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": ["**/*"]
      },
      {
        "from": "src/data",
        "to": "standalone/src/data",
        "filter": ["**/*"]
      },
      {
        "from": "src-tauri/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src-tauri/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@electric-sql/**/*",
      "node_modules/pg/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "src-tauri/icons/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAT Nexus",
      "installerIcon": "src-tauri/icons/icon.ico",
      "uninstallerIcon": "src-tauri/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
